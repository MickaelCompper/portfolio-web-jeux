<% if(content){const c=content; const isEvent=c.id==='EV-01';const section=c.id.startsWith('IP')?'informations-pratiques':isEvent?'agenda':'equipements'; %>
 <a href="/rubrique/<%= section %>">Retour à la rubrique</a><div class="detail-grid"><article><p class="lead"><%= c.summary %></p>
 <% if(isEvent){ %><p class="badge <%= c.organization==='annulé'?'cancelled':'' %>"><%= status(c,clock) %></p><% if(c.organization==='annulé'){ %><div class="notice cancelled"><h2>Événement annulé</h2><p><%= c.cancellation %></p></div><% } %><h2>Date et heures</h2><p><%= new Date(c.start).toLocaleString('fr-FR',{timeZone:'Europe/Paris'}) %> à <%= new Date(c.end).toLocaleTimeString('fr-FR',{timeZone:'Europe/Paris',hour:'2-digit',minute:'2-digit'}) %> — Europe/Paris</p><h2>Public</h2><p><%= c.audience %></p><h2>Conditions</h2><p><%= c.conditions %></p><h2>Lieu</h2><% const place=list.find(p=>p.id===c.place);if(place){ %><p><a href="/contenu/<%= place.id %>"><%= place.title %></a></p><p><%= place.address %> <%= place.entrance %></p><% }else{ %><p>Informations du lieu indisponibles.</p><% } %><% } %>
 <div class="prose"><% for(const line of c.body.split('\n').filter(Boolean)){ %><p><%= line %></p><% } %></div>
 <% if(c.exceptionDate){ %><aside class="notice exception"><h2><%= clock.slice(0,10)>c.exceptionDate?'Exception passée':'Exception d’ouverture' %> — <%= c.exceptionDate %></h2><p>Période affectée : <%= c.exceptionPeriod %></p><p><%= c.exceptionText %></p></aside><% } %>
 <% if(c.id==='IP-01'||c.id==='EQ-01'){ %><h2>Horaires ordinaires</h2><% if(c.hours){ %><dl class="hours"><% for(const line of c.hours.split('\n')){const [day,...ranges]=line.split('|'); %><div><dt><%= day %></dt><dd><%= ranges.join('|') %></dd></div><% } %></dl><% }else{ %><p>Horaires non renseignés</p><% } %><h2>Adresse et entrée</h2><p><%= c.address %> <%= c.entrance %></p><% } %>
 <% if(c.id==='EQ-01'){ %><h2>Accès physique</h2><p><%= c.access %></p><h2>Événement associé</h2><% const ev=list.find(p=>p.id==='EV-01'&&p.place===c.id);if(ev){ %><p class="badge <%= ev.organization==='annulé'?'cancelled':'' %>"><%= status(ev,clock) %></p><p><a href="/contenu/EV-01"><%= ev.title %> — <%= status(ev,clock) %></a></p><% if(ev.organization==='annulé'){ %><p><%= ev.cancellation %></p><% } %><% }else{ %><p>Aucun événement associé publié.</p><% } %><% } %>
 <% if(c.id==='IP-01'){ %><a class="button" href="/contenu/IP-02">Préparer une visite à l’accueil →</a><% }if(c.id==='IP-02'){ %><a class="button" href="/contenu/IP-01">Venir à l’accueil de la mairie →</a><% } %>
 <p class="meta">Mise à jour : <%= c.date %>.</p></article><aside class="context"><h2>À Belle-Rive</h2><p>Retrouvez les lieux, les horaires et les événements de Belle-Rive.</p><img src="/rive.svg" alt="" width="616" height="454"><a href="/recherche">Rechercher une information</a></aside></div>
<% } %>
