<!doctype html>
<html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> — Belle-Rive</title><link rel="stylesheet" href="/style.css"><% if(session){ %><script src="/edition/session.js" defer></script><% } %></head>
<body><a class="skip" href="#principal">Aller au contenu</a><div class="ribbon" role="region" aria-label="Nature de la démonstration">Démonstration personnelle — commune et données fictives</div>
<header><a class="brand" href="/">Belle-Rive</a><nav aria-label="Navigation principale"><a href="/rubrique/informations-pratiques">Informations pratiques</a><a href="/rubrique/agenda">Agenda</a><a href="/rubrique/equipements">Équipements</a></nav><form class="search" action="/recherche" method="get"><label for="q">Rechercher une information</label><div><input id="q" name="q" value="<%= q %>" type="search"><button type="submit">Rechercher</button></div></form></header>
<main id="principal" tabindex="-1">
<% if(session){ %><aside class="session" data-session data-expiry="<%= session.expiry %>" data-now="<%= session.now %>"><div id="warning" role="status" aria-live="polite"><% if(session.warning){ %>Votre session va expirer dans deux minutes. Prolongez-la pour continuer l’édition. Cette action ne publie pas vos modifications.<% } %></div><p id="expiry">Échéance serveur : <%= new Date(session.expiry).toLocaleString('fr-FR',{timeZone:'Europe/Paris'}) %> (Paris). L’activité ordinaire ne repousse pas l’échéance de quatre heures.</p><form method="post" action="/edition/prolonger" data-extend><input type="hidden" name="csrf" value="<%= csrf %>"><button>Prolonger la session</button></form><form method="post" action="/edition/deconnexion"><input type="hidden" name="csrf" value="<%= csrf %>"><button class="secondary">Déconnexion</button></form><a href="/edition">Édition et opérations</a></aside><% } %>
<% if(kind==='home'){ %>
 <section class="hero"><div><p class="eyebrow">Votre quotidien</p><h1><%= title %></h1><p>Préparer une visite, découvrir un lieu, consulter les événements du scénario.</p><a class="button light" href="/rubrique/informations-pratiques">Informations pratiques →</a></div><img src="/rive.svg" alt="" width="616" height="454"></section>
 <h2>Trouver votre information</h2><div class="cards"><article><small>01</small><h3>Informations pratiques</h3><p>Préparer une visite à l’accueil de la mairie.</p><a href="/rubrique/informations-pratiques">Consulter les informations →</a></article><article><small>02</small><h3>Agenda</h3><p>Dates, publics et conditions des événements fictifs.</p><a href="/rubrique/agenda">Voir l’agenda →</a></article><article><small>03</small><h3>Équipements</h3><p>Retrouver un lieu, ses horaires et les informations d’accès.</p><a href="/rubrique/equipements">Voir les équipements →</a></article></div>
 <h2>À l’agenda</h2><p>Horloge fictive : <%= new Date(clock).toLocaleString('fr-FR',{timeZone:'Europe/Paris'}) %> — Europe/Paris</p>
<% } else { %><p class="breadcrumb"><a href="/">Accueil</a> / <%= title %></p><h1><%= title %></h1><% } %>
<% if(message){ %><div class="notice" role="status"><p><%= message %></p></div><% } %>
<% if(kind==='list' && body==='agenda'){ %><p>Horloge fictive : <%= new Date(clock).toLocaleString('fr-FR',{timeZone:'Europe/Paris'}) %> — Europe/Paris</p><a href="/rubrique/agenda<%= past?'':'?passes=1' %>"><%= past?'Événements non terminés':'Voir les événements passés' %></a><% } %>
<% if(['home','list','search','dashboard'].includes(kind)){ %>
 <% if(!list.length && kind!=='search'){ %><p>Aucun événement dans cette sélection.</p><% if(kind==='home'){ %><a href="/rubrique/agenda?passes=1">Voir les événements passés</a><% } %><% } %>
 <div class="results"><% for(const c of list){ %><article><% if(c.id==='EV-01'){ %><p class="badge <%= c.organization==='annulé'?'cancelled':'' %>"><%= status(c,clock) %> · <%= new Date(c.start).toLocaleDateString('fr-FR',{timeZone:'Europe/Paris',day:'numeric',month:'long',year:'numeric'}) %> · Europe/Paris</p><% }else{ %><p class="eyebrow"><%= c.id.startsWith('IP')?'Information pratique':'Équipement' %></p><% } %><h2><a href="<%= kind==='dashboard'?'/edition/contenu/':'/contenu/' %><%= c.id %>"><%= c.title %></a></h2><p><%= c.summary %></p><% if(c.id==='EV-01'&&c.organization==='annulé'){ %><p class="notice cancelled"><%= c.cancellation %></p><% } %></article><% } %></div>
 <% if(kind==='home'){ %><img class="mobile-rive" src="/rive.svg" alt="" width="616" height="454"><% } %>
<% } %>
<% if(kind==='detail'){const c=content; const isEvent=c.id==='EV-01';const section=c.id.startsWith('IP')?'informations-pratiques':isEvent?'agenda':'equipements'; %>
 <a href="/rubrique/<%= section %>">Retour à la rubrique</a><div class="detail-grid"><article><p class="lead"><%= c.summary %></p>
 <% if(isEvent){ %><p class="badge <%= c.organization==='annulé'?'cancelled':'' %>"><%= status(c,clock) %></p><% if(c.organization==='annulé'){ %><div class="notice cancelled"><h2>Événement annulé</h2><p><%= c.cancellation %></p></div><% } %><h2>Date et heures fictives</h2><p><%= new Date(c.start).toLocaleString('fr-FR',{timeZone:'Europe/Paris'}) %> à <%= new Date(c.end).toLocaleTimeString('fr-FR',{timeZone:'Europe/Paris',hour:'2-digit',minute:'2-digit'}) %> — Europe/Paris</p><h2>Public</h2><p><%= c.audience %></p><h2>Conditions</h2><p><%= c.conditions %></p><h2>Lieu</h2><% const place=list.find(p=>p.id===c.place);if(place){ %><p><a href="/contenu/<%= place.id %>"><%= place.title %></a></p><p><%= place.address %> <%= place.entrance %></p><% }else{ %><p>Informations du lieu indisponibles.</p><% } %><% } %>
 <div class="prose"><% for(const line of c.body.split('\n').filter(Boolean)){ %><p><%= line %></p><% } %></div>
 <% if(c.exceptionDate){ %><aside class="notice exception"><h2><%= clock.slice(0,10)>c.exceptionDate?'Exception passée':'Exception d’ouverture' %> — <%= c.exceptionDate %></h2><p>Période affectée : <%= c.exceptionPeriod %></p><p><%= c.exceptionText %></p></aside><% } %>
 <% if(c.id==='IP-01'||c.id==='EQ-01'){ %><h2>Horaires ordinaires</h2><% if(c.hours){ %><dl class="hours"><% for(const line of c.hours.split('\n')){const [day,...ranges]=line.split('|'); %><div><dt><%= day %></dt><dd><%= ranges.join('|') %></dd></div><% } %></dl><% }else{ %><p>Horaires non renseignés dans cette démonstration</p><% } %><h2>Adresse et entrée</h2><p><%= c.address %> <%= c.entrance %></p><% } %>
 <% if(c.id==='EQ-01'){ %><h2>Accès physique</h2><p><%= c.access %></p><h2>Événement associé</h2><% const ev=list.find(p=>p.id==='EV-01'&&p.place===c.id);if(ev){ %><p class="badge <%= ev.organization==='annulé'?'cancelled':'' %>"><%= status(ev,clock) %></p><p><a href="/contenu/EV-01"><%= ev.title %> — <%= status(ev,clock) %></a></p><% if(ev.organization==='annulé'){ %><p><%= ev.cancellation %></p><% } %><% }else{ %><p>Aucun événement associé publié dans cette démonstration.</p><% } %><% } %>
 <% if(c.id==='IP-01'){ %><a class="button" href="/contenu/IP-02">Préparer une visite à l’accueil →</a><% }if(c.id==='IP-02'){ %><a class="button" href="/contenu/IP-01">Venir à l’accueil de la mairie →</a><% } %>
 <p class="meta">Date éditoriale fictive : <%= c.date %>. Démonstration personnelle, aucun service réel.</p></article><aside class="context"><h2>À Belle-Rive</h2><p>Des informations imaginaires pour explorer trois parcours du quotidien.</p><img src="/rive.svg" alt="" width="616" height="454"><a href="/recherche">Rechercher une information</a></aside></div>
<% } %>
<% if(kind==='login'){ %><div class="editor"><p>Saisissez le secret affiché dans votre terminal local. Il ne s’agit pas d’un compte usager. Le collage et les outils d’assistance restent autorisés.</p><form method="post" action="/edition/connexion"><input type="hidden" name="csrf" value="<%= csrf %>"><label for="secret">Secret de lancement — obligatoire</label><input id="secret" name="secret" type="password" autocomplete="current-password" required aria-describedby="secret-help<%= errors.secret?' secret-error':'' %>" <%= errors.secret?'aria-invalid=true':'' %>><p id="secret-help">Secret renouvelé à chaque démarrage.</p><% if(errors.secret){ %><p id="secret-error" class="error"><%= errors.secret %></p><% } %><button>Ouvrir l’édition</button></form></div><% } %>
<% if(kind==='dashboard'){ %><h2>Opérations conservées</h2><p>Après une réponse perdue ou un redémarrage, vérifiez ici le résultat avant de recommencer.</p><% if(!operations.length){ %><p>Aucune opération de publication conservée.</p><% }for(const o of operations){ %><p><a href="/edition/operation/<%= o.id %>"><%= o.id %> — <%= o.content %>, r<%= o.rev %></a> · publication réelle <%= o.published %></p><% } %><% } %>
<% if(kind==='edit'){const c=form; %><div class="editor"><p class="notice">Brouillon — non publié. Base publique r<%= base %> inchangée.</p><p id="dirty" role="status" tabindex="-1"><%= saved?'Dernier enregistrement réel : '+saved:'Modifications non enregistrées' %></p>
 <% if(Object.keys(errors).length){ %><section id="errors" class="notice cancelled" tabindex="-1" data-focus><h2>Corriger avant publication</h2><ul><% for(const [f,text]of Object.entries(errors)){ %><li><a href="#<%= f %>"><%= labels[f] %> : <%= text %></a></li><% } %></ul></section><% } %>
 <form action="/edition/contenu/<%= c.id %>/enregistrer" method="post" data-draft><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="generation" value="<%= generation %>"><input type="hidden" name="base" value="<%= base %>"><% for(const f of relevant(c.id)){ %><div class="field"><label for="<%= f %>"><%= labels[f] %><%= ['title','summary','body','date','address','entrance','hours','start','end','organization','audience','conditions','place','access'].includes(f)?' — obligatoire':'' %></label><% if(['body','summary','hours','exceptionText','conditions','access','cancellation'].includes(f)){ %><textarea id="<%= f %>" name="<%= f %>" rows="<%= f==='hours'?8:3 %>" <%= errors[f]?'aria-invalid=true':'' %> aria-describedby="<%= f %>-hint"><%= c[f] %></textarea><% }else{ %><input id="<%= f %>" name="<%= f %>" value="<%= c[f] %>" <%= errors[f]?'aria-invalid=true':'' %> aria-describedby="<%= f %>-hint"><% } %><p id="<%= f %>-hint" class="<%= errors[f]?'error':'hint' %>"><%= errors[f]||'Texte du scénario uniquement. Aucun HTML.' %></p></div><% } %><button>Enregistrer le brouillon</button></form>
 <form action="/edition/contenu/<%= c.id %>/preparer" method="post" data-prepare><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="generation" value="<%= generation %>"><input type="hidden" name="base" value="<%= base %>"><button class="secondary">Préparer la publication du brouillon enregistré</button><p>Enregistrez la saisie avant de préparer. Cette action ne publie rien.</p></form>
 <details><summary>Historique immuable conservé</summary><% for(const h of history){ %><h3>r<%= h.rev %></h3><pre><%= JSON.stringify(JSON.parse(h.json),null,2) %></pre><% } %></details></div><% } %>
<% if(kind==='confirm'){const c=form; %><div class="editor"><p>Vous allez remplacer la version publique r<%= base %> de <strong><%= c.title %></strong>. La version précédente restera conservée.</p><h2>Résumé à vérifier</h2><dl><% for(const f of relevant(c.id)){ %><dt><%= labels[f] %></dt><dd class="prose"><%= c[f]||'Non renseigné / sans objet' %></dd><% } %></dl><p>Opération : <span id="operation-id"><%= op %></span></p><form method="post" action="/edition/contenu/<%= c.id %>/publier" data-publish data-operation="<%= op %>"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="generation" value="<%= generation %>"><input type="hidden" name="base" value="<%= base %>"><input type="hidden" name="op" value="<%= op %>"><button>Publier cette révision</button></form><div id="uncertain" role="status" hidden><h2>Publication à vérifier</h2><p>La confirmation n’a pas été reçue. La publication a peut-être été enregistrée. Vérifiez le résultat avant de recommencer.</p><a href="/edition/operation/<%= op %>">Vérifier le résultat</a></div><p><a href="/edition/operation/<%= op %>">Vérifier le résultat de cette opération</a></p><a href="/edition/contenu/<%= c.id %>">Revenir au brouillon</a></div><% } %>
<% if(kind==='result'&&operation){ %><div class="notice"><h2>La révision r<%= operation.rev %> est publiée dans le scénario.</h2><p>Anciennes révisions conservées. Horodatage réel : <%= operation.published %></p><p>Opération : <%= operation.id %></p></div><a class="button" href="/contenu/<%= operation.content %>">Consulter la fiche publique</a><a href="/edition/contenu/<%= operation.content %>">Préparer une autre révision</a><% } %>
<% if(kind==='message'){ %><p><a href="/edition/connexion">Ouvrir une nouvelle session éditoriale</a></p><% } %>
</main><footer><p class="brand">Belle-Rive</p><p>Démonstration personnelle · Commune et données fictives · Aucun service réel</p><p>Textes et illustration originaux, avec assistance Codex. <a href="/edition/connexion">Édition locale</a></p></footer></body></html>

